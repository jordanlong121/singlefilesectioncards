    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanlong121/singlefilesectioncards.git"
  }
