{
  "name": "obsidian-single-file-section-cards",
  "version": "2.4.2",
  "description": "Obsidian plugin: view a single note's sections as editable cards",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node test/run.mjs",
    "lint": "eslint main.ts editor-embed.ts src"
  },
  "keywords": [
    "obsidian-plugin"
  ],
  "author": "Jordan Long",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.66.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanlong121/singlefilesectioncards.git"
  },
  "dependencies": {
    "ical.js": "^2.2.1"
  }
}
