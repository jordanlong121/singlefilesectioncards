{
  "name": "obsidian-single-file-section-cards",
  "version": "1.2.3",
  "description": "Obsidian plugin: view a single note's sections as editable cards",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
